RunService.Heartbeat:Connect(function()
    if not MagnetManager.Active then return end
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Khởi tạo hoặc duy trì Target
    if not MagnetManager.TargetAttachment or not MagnetManager.TargetAttachment.Parent then
        MagnetManager.TargetAttachment = Instance.new("Attachment")
        MagnetManager.TargetAttachment.Name = "MagnetTarget"
        MagnetManager.TargetAttachment.Position = Vector3.new(0, 0, -12)
        MagnetManager.TargetAttachment.Parent = root
    end
    
    -- Quét và Hút Part
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v.Anchored and not v:IsDescendantOf(char) then
            local dist = (v.Position - root.Position).Magnitude
            
            if dist <= MagnetManager.Range then
                if not MagnetManager.Objects[v] then
                    local att = Instance.new("Attachment", v)
                    local ap = Instance.new("AlignPosition", v)
                    ap.Mode = Enum.PositionAlignmentMode.OneAttachment
                    ap.Attachment0 = att
                    ap.Attachment1 = MagnetManager.TargetAttachment
                    ap.Responsiveness = 20
                    ap.MaxForce = 10000
                    
                    MagnetManager.Objects[v] = {AP = ap, Att = att}
                end
            else
                if MagnetManager.Objects[v] then
                    MagnetManager.Objects[v].AP:Destroy()
                    MagnetManager.Objects[v].Att:Destroy()
                    MagnetManager.Objects[v] = nil
                end
            end
        end
    end
end)

