-- Hàm dọn dẹp (Cleanup) chuyên sâu
local function CleanupMagnet()
    for obj, data in pairs(MagnetManager.Objects) do
        if data.AP then data.AP:Destroy() end
        if data.Att then data.Att:Destroy() end
    end
    MagnetManager.Objects = {}
    if MagnetManager.TargetAttachment then 
        MagnetManager.TargetAttachment:Destroy() 
        MagnetManager.TargetAttachment = nil 
    end
end

