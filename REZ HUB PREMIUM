Tabs.Farm:AddToggle("MagnetToggle", {
    Title = "Hút Part (Magnet System)",
    Description = "Sử dụng AlignPosition, mượt mà không lag",
    Default = false,
    Callback = function(v) 
        MagnetManager.Active = v 
        if not v then CleanupMagnet() end
    end
})

Tabs.Fram:AddSlider("RangeSlider", {
    Title = "Phạm vi hút (Studs)",
    Min = 5,
    Max = 100,
    Default = 20,
    Callback = function(v)
        MagnetManager.Range = v
    end
})

Tabs.Fram:AddButton({
    Title = "Dọn sạch rác Magnet",
    Description = "Force reset tất cả AlignPosition trong map",
    Callback = function()
        CleanupMagnet()
        Fluent:Notify({Title = "Zidwi System", Content = "Đã dọn dẹp các vật thể bị hút!", Duration = 3})
    end
})

-- =====================================================================
-- 💾 SAVE CONFIG SYSTEM
-- =====================================================================

local SaveManager = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"
))()

local InterfaceManager = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"
))()

InterfaceManager:SetLibrary(Fluent)
SaveManager:SetLibrary(Fluent)

InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)

SaveManager:IgnoreThemeSettings()

InterfaceManager:SetFolder("RezHub")
SaveManager:SetFolder("RezHub/Configs")

SaveManager:LoadAutoloadConfig()

local AutoSave = true

Tabs.Settings:AddToggle("AutoSave", {
    Title = "Auto Save Config",
    Description = "Tự động lưu cấu hình",
    Default = true
}):OnChanged(function(Value)
    AutoSave = Value

    if AutoSave then
        pcall(function()
            SaveManager:Save()
        end)
    end
end)

