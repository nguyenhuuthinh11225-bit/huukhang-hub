Tabs.Auto:Section({ Title = "Auto Farm Log", Icon = "axe" })

local autoTreeFarmActive = false
local autoFarmEnabled = false
local originalPosition
local clickConnection
local lastClickTime = 0
local clickDelay = 0.3
local VirtualInputManager = game:GetService("VirtualInputManager")

local function createNotif(title, text, duration)
    Fluent:Notify({ Title = title, Content = text, Duration = duration or 3 })
end

local function simulateClick()
    if not autoFarmEnabled then return end
    if tick() - lastClickTime < clickDelay then return end
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    local clickX = viewportSize.X - 10
    local clickY = viewportSize.Y * 0.75
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
    lastClickTime = tick()
end

local function teleportToAirAndAnchor()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        originalPosition = char.HumanoidRootPart.CFrame
        local airPos = char.HumanoidRootPart.Position + Vector3.new(0, 350, 0)
        char.HumanoidRootPart.CFrame = CFrame.new(airPos)
        task.wait(0.5)
        char.HumanoidRootPart.Anchored = true
        return true
    end
    return false
end

local function unanchorPlayer()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = false
        if originalPosition then
            char.HumanoidRootPart.CFrame = originalPosition
        end
    end
end

local function teleportAllTreesToPlayer()
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return false end
    local playerPos = char.HumanoidRootPart.Position
    local treesFound = 0
    if not workspace:FindFirstChild("Map") then return false end

    local function teleportTreesFromFolder(folder)
        if not folder then return 0 end
        local count = 0
        for _, item in pairs(folder:GetChildren()) do
            local isSmallTree = false
            if item.Name == "Small Tree" and item:IsA("Model") then isSmallTree = true
            elseif item:IsA("Model") then
                local hasLeaves = item:FindFirstChild("Leaves") ~= nil
                local hasTrunk = item:FindFirstChild("Trunk") ~= nil or item:FindFirstChild("trunk") ~= nil
                local hasWood = item:FindFirstChild("Wood") ~= nil
                if (hasLeaves or hasWood) and not hasTrunk then isSmallTree = true
            end
            if isSmallTree then
                count = count + 1
                local targetPos = Vector3.new(
                    playerPos.X + math.random(-3, 3),
                    playerPos.Y - 5,
                    playerPos.Z + math.random(-3, 3)
                )
                pcall(function()
                    if item.PrimaryPart then
                        item:SetPrimaryPartCFrame(CFrame.new(targetPos))
                    else
                        local mainPart = item:FindFirstChildOfClass("BasePart")
                        if mainPart then
                            local offset = targetPos - mainPart.Position
                            for _, part in pairs(item:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.CFrame = part.CFrame + offset
                                end
                            end
                        end
                    end
                end)
                task.wait(0.05)
            end
        end
        return count
    end

    local map = workspace.Map
    if map:FindFirstChild("Landmarks") then treesFound = treesFound + teleportTreesFromFolder(map.Landmarks) end
    if map:FindFirstChild("Foliage") then treesFound = treesFound + teleportTreesFromFolder(map.Foliage) end
    return treesFound > 0
end

local function teleportAllLogsToPlayer()
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return false end
    local playerPos = char.HumanoidRootPart.Position
    if not workspace:FindFirstChild("Items") then return false end
    for _, item in pairs(workspace.Items:GetChildren()) do
        if item:FindFirstChild("Meshes/log_Cylinder") then
            local logPos = Vector3.new(
                playerPos.X + math.random(-4, 4),
                playerPos.Y + 1,
                playerPos.Z + math.random(-4, 4)
            )
            pcall(function()
                if item.PrimaryPart then
                    item:SetPrimaryPartCFrame(CFrame.new(logPos))
                else
                    local mainPart = item:FindFirstChildOfClass("BasePart")
                    if mainPart then
                        local offset = logPos - mainPart.Position
                        for _, part in pairs(item:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.CFrame = part.CFrame + offset
                            end
                        end
                    end
                end
            end)
            task.wait(0.03)
        end
    end
    return true
end

