        Callback = function(input)
            jobIdInput = input
        end
    })

    Tabs.Server:AddButton({
        Title = "Join JobId",
        Description = "Teleport đến server bạn muốn",
        Callback = function()
            if jobIdInput == "" then
                notify("Error", "Ghi job id vô lm ơn")
                return
            end

            local success, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, jobIdInput, LocalPlayer)
            end)

            if success then
                notify("Teleporting...", "Joining JobId: " .. jobIdInput, 4)
            else
                notify("Error", "Không thể join JobId: " .. tostring(err), 4)
            end
        end
    })


    local function smartRejoin()
        if game.PrivateServerId ~= "" then
            warn("Rejoin: Private Server")
            TeleportService:TeleportToPrivateServer(
                PlaceId,
                game.PrivateServerId,
                {LocalPlayer}
            )
        else
            warn("Rejoin: Public Server")
            TeleportService:Teleport(PlaceId, LocalPlayer)
        end
    end

    Tabs.Server:AddButton({
        Title = "Rejoin Server",
        Description = "Tự nhận diện server thường / private",
        Callback = smartRejoin
    })

    local function serverHop()
        while true do
            local success, result = pcall(function()
                return HttpService:JSONDecode(
                    game:HttpGet(
                        "https://games.roblox.com/v1/games/" ..
                        PlaceId ..
                        "/servers/Public?sortOrder=Asc&limit=100&cursor=" ..
                        hopCursor
                    )
                )
            end)

            if not success or not result or not result.data then
                notify("Error", "Đéo lấy dc dữ liệu server", 4)
                return
            end

            for _, server in ipairs(result.data) do
                if server.playing < server.maxPlayers
                    and server.id ~= JobId
                    and not triedServers[server.id] then

                    triedServers[server.id] = true
                    notify("Hop Server", "Đợi tí...", 5)
                    task.wait(1)
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                    return
                end
            end

            hopCursor = result.nextPageCursor or ""
            if hopCursor == "" then
                notify("No Servers", "Chả tìm thấy server nào", 4)
                return
            end
            -- else: loop continues to next page
        end
    end

    Tabs.Server:AddButton({
        Title = "Hop Server",
        Description = "Bấm zô",
        Callback = function()
            hopCursor = ""
            triedServers = {}
            serverHop()
        end
    })

end

