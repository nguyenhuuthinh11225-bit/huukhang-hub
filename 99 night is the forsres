local function NOFLY()
    FLYING = false
    if mfly1 then mfly1:Disconnect(); mfly1 = nil end
    if mfly2 then mfly2:Disconnect(); mfly2 = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            if root:FindFirstChild("BodyVelocity") then root:FindFirstChild("BodyVelocity"):Destroy() end
            if root:FindFirstChild("BodyGyro") then root:FindFirstChild("BodyGyro"):Destroy() end
        end
    end
end

local function MobileFly()
    NOFLY()
    FLYING = true
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart")
    local camera = workspace.CurrentCamera
    local v3inf = Vector3.new(9e9, 9e9, 9e9)
    local controlModule = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))

    local bv = Instance.new("BodyVelocity")
    bv.Name = "BodyVelocity"
    bv.Parent = root
    bv.MaxForce = Vector3.new(0, 0, 0)
    bv.Velocity = Vector3.new()

    local bg = Instance.new("BodyGyro")
    bg.Name = "BodyGyro"
    bg.Parent = root
    bg.MaxTorque = v3inf
    bg.P = 1000
    bg.D = 50

    mfly1 = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.1)
        if FLYING then
            local newRoot = newChar:FindFirstChild("HumanoidRootPart")
            if newRoot then
                local newBv = Instance.new("BodyVelocity")
                newBv.Name = "BodyVelocity"
                newBv.Parent = newRoot
                newBv.MaxForce = v3inf
                newBv.Velocity = Vector3.new()
                local newBg = Instance.new("BodyGyro")
                newBg.Name = "BodyGyro"
                newBg.Parent = newRoot
                newBg.MaxTorque = v3inf
                newBg.P = 1000
                newBg.D = 50
                local hum = newChar:FindFirstChildOfClass("Humanoid")
                if hum then hum.PlatformStand = true end
            end
        end
    end)

    mfly2 = RunService.RenderStepped:Connect(function()
        if not FLYING then return end
        local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        local bv = rootPart:FindFirstChild("BodyVelocity")
        local bg = rootPart:FindFirstChild("BodyGyro")
        if not bv or not bg then return end
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        bv.MaxForce = v3inf
        bg.MaxTorque = v3inf
        hum.PlatformStand = true
        bg.CFrame = camera.CoordinateFrame
        local moveVec = controlModule:GetMoveVector()
        local vel = Vector3.new()
        if moveVec.X ~= 0 then vel = vel + camera.CFrame.RightVector * moveVec.X * flySpeed * 50 end
        if moveVec.Z ~= 0 then vel = vel - camera.CFrame.LookVector * moveVec.Z * flySpeed * 50 end
        bv.Velocity = vel
    end)
end

