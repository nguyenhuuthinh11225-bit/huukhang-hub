-- CORE HIỂN THỊ ESP BOX
local function ClearAllBoxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local box = player.Character:FindFirstChild("V15_BoxESP")
            if box then box:Destroy() end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if EspEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local char = player.Character
                local root = char.HumanoidRootPart
                
                local boxInstance = char:FindFirstChild("V15_BoxESP")
                if not boxInstance then
                    boxInstance = Instance.new("BoxHandleAdornment")
                    boxInstance.Name = "V15_BoxESP"
                    boxInstance.Adornee = root
                    boxInstance.AlwaysOnTop = true
                    boxInstance.ZIndex = 5
                    boxInstance.Size = Vector3.new(4, 5.5, 1.5)
                    boxInstance.Color3 = Color3.fromRGB(255, 105, 180)
                    boxInstance.Transparency = 0.5
                    boxInstance.Parent = char
                end
            end
        end
    else
        ClearAllBoxes()
    end
end)

task.spawn(function()
