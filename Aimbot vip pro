-- [4] FIX LỖI: NÚT FIX LAG CÓ THỂ BẬT / TẮT LINH HOẠT
AntiLagButton.MouseButton1Click:Connect(function()
    AntiLagEnabled = not AntiLagEnabled
    if AntiLagEnabled then
        AntiLagButton.Text = "⚡ Siêu Giảm Lag: ON"
        AntiLagButton.BackgroundColor3 = Color3.fromRGB(65, 160, 95)
        
        Lighting.ClockTime = 19
        Lighting.Brightness = 1
        Lighting.GlobalShadows = false
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                -- Sao lưu trước khi đổi
                if not OriginalMaterials[obj] then OriginalMaterials[obj] = obj.Material end
                obj.Material = Enum.Material.SmoothPlastic
                if obj.Name:lower():find("leaf") or obj.Name:lower():find("tree") or obj.Name:lower():find("grass") then
                    obj.CastShadow = false
                end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                if not OriginalColors[obj] then OriginalColors[obj] = obj.Transparency end
                obj.Transparency = 1 -- Ẩn đi thay vì xóa hẳn để dễ khôi phục
            end
        end
    else
        AntiLagButton.Text = "⚡ Siêu Giảm Lag: OFF"
        AntiLagButton.BackgroundColor3 = Color3.fromRGB(210, 70, 90)
        
        -- Khôi phục cấu hình gốc
        Lighting.ClockTime = 12
        Lighting.GlobalShadows = true
        
        for obj, mat in pairs(OriginalMaterials) do
            if obj and obj.Parent then obj.Material = mat end
        end
        for obj, trans in pairs(OriginalColors) do
            if obj and obj.Parent then obj.Transparency = trans end
        end
    end
end)

