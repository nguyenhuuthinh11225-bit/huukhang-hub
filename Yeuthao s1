<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Xin lỗi Thảo 💓</title>

<style>
body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    font-family:Arial,sans-serif;
    background:#ffd6e7;
    overflow:hidden;
}

h1{
    color:#ff1493;
    text-align:center;
}

#buttons{
    margin-top:20px;
}

button{
    padding:12px 24px;
    font-size:20px;
    border:none;
    border-radius:12px;
    cursor:pointer;
    margin:10px;
}

#yes{
    background:#ff4da6;
    color:white;
}

#no{
    background:#222;
    color:white;
    position:absolute;
}

.heart{
    width:180px;
    height:180px;
    background:red;
    position:relative;
    transform:rotate(-45deg);
    margin:auto;
}

.heart:before,
.heart:after{
    content:"";
    width:180px;
    height:180px;
    background:red;
    border-radius:50%;
    position:absolute;
}

.heart:before{
    top:-90px;
    left:0;
}

.heart:after{
    left:90px;
    top:0;
}

.name{
    position:absolute;
    font-size:32px;
    color:white;
    font-weight:bold;
    transform:rotate(45deg);
    z-index:2;
}

#success{
    display:none;
    text-align:center;
}
</style>
</head>

<body>

<div id="main">
    <h1>Đừng dỗi nữa mò 😭<br>Tha lỗi cho anh nhé</h1>

    <div id="buttons">
        <button id="yes">Tha lỗi 💓</button>
        <button id="no">Đéo 🖕</button>
    </div>
</div>

<div id="success">
    <h1>Em tha lỗi cho anh rồi nhé bé iu 💓💓💓</h1>

    <div style="position:relative;display:flex;justify-content:center;margin-top:50px;">
        <div class="heart"></div>
        <div class="name">THẢO</div>
    </div>
</div>

<script>
let scale = 1;

const noBtn = document.getElementById("no");
const yesBtn = document.getElementById("yes");

noBtn.addEventListener("mouseover", () => {
    const x = Math.random() * (window.innerWidth - 150);
    const y = Math.random() * (window.innerHeight - 80);

    noBtn.style.left = x + "px";
    noBtn.style.top = y + "px";

    scale *= 2;
    yesBtn.style.transform = `scale(${scale})`;
});

yesBtn.addEventListener("click", () => {
    document.getElementById("main").style.display = "none";
    document.getElementById("success").style.display = "block";
});
</script>

</body>
</html>
